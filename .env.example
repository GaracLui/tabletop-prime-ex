# ──────────────────────────────────────────────────────────────────────
# TableTop Prime — environment template
#
# Copy to `.env` (git-ignored) and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real `.env`. It is untracked on purpose (S5): any
# credential that lands in it must not be committed automatically.
# ──────────────────────────────────────────────────────────────────────

# Prisma (v7, driver adapter @prisma/adapter-pg) → Supabase Postgres.
# Use the session-pooler connection string from Supabase → Project
# Settings → Database. The direct `db.<ref>.supabase.co:5432` host works
# for migrations if your network allows IPv6.
DATABASE_URL="postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Supabase project — used by @supabase/ssr (server.ts / browser.ts / proxy).
# Both values are public-by-design (they ship in client JS), but keep them
# in env vars so environments can differ.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<sb_publishable_... or anon key>"

# Optional. Base URL used for metadata/absolute URLs in layout.tsx when no
# deployment platform (e.g. Vercel) provides one. Defaults to
# http://localhost:3000 in development.
# NEXTAUTH_URL="http://localhost:3000"
