    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sort": "node scripts/i18n-sort.mjs",
    "i18n:sort:check": "node scripts/i18n-sort.mjs --check"
  },
